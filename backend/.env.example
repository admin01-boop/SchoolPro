# Copy this file to .env and fill in real values for your environment.
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Set to switch database engine, e.g.:
# DATABASE_URL=postgres://db_user:db_password@127.0.0.1:5432/school_db   (needs requirements-postgres.txt)
# DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/school_db      (needs requirements-mysql.txt)
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Settings module: config.settings.dev (default for manage.py) or config.settings.prod (default for wsgi/asgi).
# DJANGO_SETTINGS_MODULE=config.settings.dev
LOG_LEVEL=INFO

# Auth: token lifetime and rate limits (DRF format: N/min, N/hour).
AUTH_TOKEN_TTL_HOURS=12
THROTTLE_LOGIN=5/min
THROTTLE_ANON=60/min
THROTTLE_USER=1000/min

# config.settings.prod requires these (no defaults):
# ALLOWED_HOSTS=school.example.com
# CORS_ALLOWED_ORIGINS=https://school.example.com
# CSRF_TRUSTED_ORIGINS=https://school.example.com
